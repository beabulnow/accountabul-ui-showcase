# Copy to .env and fill in for your own backend.
# Never commit a real .env. No service-role key, database password or
# blockchain signing secret belongs in this repository.

# Client-visible (safe, publishable)
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# Server-side equivalents used during SSR
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
SUPABASE_PROJECT_ID="<your-project-ref>"
